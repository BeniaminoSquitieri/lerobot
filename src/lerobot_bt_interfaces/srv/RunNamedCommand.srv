# @file RunNamedCommand.srv
# @brief C++ behavior-tree to Python executor command boundary.
#
# Request fields:
# kind selects the command path:
#   - "skill"            -> run one learned primitive
#   - "vlm_gate" -> open one gate and wait for a VLM result
string kind
# name must match one configured command entry on the Python side.
string name
# timeout_s optionally overrides the command duration; 0 lets the server decide.
float32 timeout_s
---
# Response fields:
# success is the boolean outcome consumed by the BT leaf.
bool success
# status is the detailed executor state, for example SUCCESS, FAILURE, or TIMEOUT.
string status
# elapsed_s reports how long the Python command spent executing.
float32 elapsed_s
# message carries human-readable diagnostics for logs and tests.
string message
