<!--
  @file make_coffee.xml
  @brief Scene-gated coffee preparation task.

  The human places the cup and presses the start button. The robot inserts the
  capsule and closes the machine. Every stage is a single merged leaf
  (AwaitScene or DoSkill) that combines action with VLM verification — halving
  the node count vs. the old OpenVLMGate+WaitForVLMVerdict pairs.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="Make coffee">
      <RetryUntilSuccessful name="Setup ready" num_attempts="{initial_scene_ready_max_attempts}">
        <AwaitScene name="Check coffee setup is ready" scene_name="{initial_scene_ready_gate}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Cup under dispenser" num_attempts="{cup_under_dispenser_max_attempts}">
        <AwaitScene name="Check cup is under dispenser" scene_name="{cup_under_dispenser_gate}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Insert capsule" num_attempts="{pick_and_insert_capsule_max_attempts}">
        <DoSkill name="Pick and insert capsule" skill_name="{pick_and_insert_capsule_skill}" timeout_s="{pick_and_insert_capsule_timeout_s}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Close machine" num_attempts="{close_coffee_machine_max_attempts}">
        <DoSkill name="Close coffee machine" skill_name="{close_coffee_machine_skill}" timeout_s="{close_coffee_machine_timeout_s}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Start extraction" num_attempts="{human_press_start_button_max_attempts}">
        <AwaitScene name="Check coffee extraction started" scene_name="{human_press_start_button_gate}"/>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="AwaitScene">
      <input_port name="scene_name"/>
    </Action>
    <Action ID="DoSkill">
      <input_port name="skill_name"/>
      <input_port name="timeout_s"/>
    </Action>
  </TreeNodesModel>
</root>
