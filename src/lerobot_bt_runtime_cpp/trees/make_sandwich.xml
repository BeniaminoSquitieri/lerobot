<!--
  @file make_sandwich.xml
  @brief Active sandwich behavior tree with two real BC skills and manual/VLM gates.

  1. wait for initial scene → 2. place first toast → 3. human pours →
  4. human positions second toast → 5. place second toast → 6. final check.

  Every stage is a single merged leaf (AwaitScene or DoSkill) that combines
  the action with VLM verification.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="Make sandwich">
      <RetryUntilSuccessful name="Initial scene ready" num_attempts="{initial_scene_ready_max_attempts}">
        <AwaitScene name="Check initial scene is ready" scene_name="{initial_scene_ready_gate}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Place first toast" num_attempts="{place_first_toast_max_attempts}">
        <DoSkill name="Place first toast" skill_name="{place_first_toast_skill}" timeout_s="{place_first_toast_timeout_s}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Human pours ingredient" num_attempts="{pour_ingredient_max_attempts}">
        <AwaitScene name="Check pouring is complete" scene_name="{pour_ingredient_gate}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Second toast ready" num_attempts="{second_toast_ready_max_attempts}">
        <AwaitScene name="Check second toast is ready" scene_name="{second_toast_ready_gate}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Place second toast" num_attempts="{place_second_toast_max_attempts}">
        <DoSkill name="Place second toast" skill_name="{place_second_toast_skill}" timeout_s="{place_second_toast_timeout_s}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Sandwich ready" num_attempts="{task_complete_max_attempts}">
        <AwaitScene name="Check sandwich is ready" scene_name="{task_complete_gate}"/>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="AwaitScene">
      <input_port name="scene_name"/>
    </Action>
    <Action ID="DoSkill">
      <input_port name="skill_name"/>
      <input_port name="timeout_s"/>
    </Action>
  </TreeNodesModel>
</root>
