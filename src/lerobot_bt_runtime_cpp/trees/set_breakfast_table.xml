<!--
  @file set_breakfast_table.xml
  @brief Robot task for setting the breakfast table.

  Human and robot alternate: human places tablecloth+tea+spoon, robot places
  cereal+bottle+cup+bowl. Every stage is a single merged leaf (AwaitScene or
  DoSkill) that combines action with verification.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="Set breakfast table">
      <RetryUntilSuccessful name="Tablecloth placed" num_attempts="{tablecloth_ready_max_attempts}">
        <AwaitScene name="Check tablecloth is placed" scene_name="{tablecloth_ready_gate}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Cereal box placed" num_attempts="{place_cereal_box_max_attempts}">
        <DoSkill name="Robot places cereal box" skill_name="{place_cereal_box_skill}" timeout_s="{place_cereal_box_timeout_s}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Tea box placed" num_attempts="{tea_box_ready_max_attempts}">
        <AwaitScene name="Check tea box is placed" scene_name="{tea_box_ready_gate}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Bottle placed" num_attempts="{place_bottle_max_attempts}">
        <DoSkill name="Robot places bottle" skill_name="{place_bottle_skill}" timeout_s="{place_bottle_timeout_s}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Cup placed" num_attempts="{place_cup_max_attempts}">
        <DoSkill name="Robot places cup" skill_name="{place_cup_skill}" timeout_s="{place_cup_timeout_s}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Spoon placed" num_attempts="{spoon_ready_max_attempts}">
        <AwaitScene name="Check spoon is placed" scene_name="{spoon_ready_gate}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Bowl placed" num_attempts="{place_bowl_max_attempts}">
        <DoSkill name="Robot places bowl" skill_name="{place_bowl_skill}" timeout_s="{place_bowl_timeout_s}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Table ready" num_attempts="{task_complete_max_attempts}">
        <AwaitScene name="Check breakfast table is ready" scene_name="{task_complete_gate}"/>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="AwaitScene">
      <input_port name="scene_name"/>
    </Action>
    <Action ID="DoSkill">
      <input_port name="skill_name"/>
      <input_port name="timeout_s"/>
    </Action>
  </TreeNodesModel>
</root>
