<!--
  @file items_in_drawer.xml
  @brief Scene-gated drawer insertion task.

  The human opens and closes the drawer. The robot owns a single repeated BC
  skill that inserts the next object. After every rollout, the BT waits on the
  VLM topic: `FAILURE` means more objects remain and the same skill is retried,
  while `SUCCESS` means the drawer contents are complete.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="Items in drawer - VLM scene gates">
      <RetryUntilSuccessful name="SCENE 0 - Drawer setup ready" num_attempts="{initial_scene_ready_max_attempts}">
        <Sequence name="Open setup gate, then wait for scene 0">
          <OpenVLMGate name="Open scene 0 gate" gate_name="{initial_scene_ready_gate}"/>
          <WaitForVLMVerdict name="Wait scene 0 ready" check_name="{initial_scene_ready_gate}"/>
        </Sequence>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="SCENE 1 - Human opens drawer" num_attempts="{drawer_open_gate_max_attempts}">
        <Sequence name="Open human-open gate, then wait for drawer open">
          <OpenVLMGate name="Open drawer-open gate" gate_name="{drawer_open_gate}"/>
          <WaitForVLMVerdict
            name="Wait scene 1 ready - drawer open"
            check_name="{drawer_open_gate}"/>
        </Sequence>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="SCENE 2 - Insert next drawer item" num_attempts="{insert_next_drawer_item_max_attempts}">
        <Sequence name="Insert next object, then check if more remain">
          <RunRobotSkill
            name="Insert next drawer item"
            skill_name="{insert_next_drawer_item_skill}"
            timeout_s="{insert_next_drawer_item_timeout_s}"/>
          <WaitForVLMVerdict
            name="Wait scene 2 verdict - drawer contents complete"
            check_name="{insert_next_drawer_item_skill}"/>
        </Sequence>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="SCENE 3 - Human closes drawer" num_attempts="{drawer_closed_gate_max_attempts}">
        <Sequence name="Open human-close gate, then wait for drawer closed">
          <OpenVLMGate name="Open drawer-closed gate" gate_name="{drawer_closed_gate}"/>
          <WaitForVLMVerdict
            name="Wait scene 3 ready - drawer closed"
            check_name="{drawer_closed_gate}"/>
        </Sequence>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="TASK COMPLETE - Drawer task done" num_attempts="{task_complete_max_attempts}">
        <Sequence name="Open task-complete gate, then wait for final verdict">
          <OpenVLMGate name="Open task-complete gate" gate_name="{task_complete_gate}"/>
          <WaitForVLMVerdict name="Wait task complete" check_name="{task_complete_gate}"/>
        </Sequence>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="OpenVLMGate">
      <input_port name="gate_name"/>
    </Action>
    <Action ID="RunRobotSkill">
      <input_port name="skill_name"/>
      <input_port name="timeout_s"/>
    </Action>
    <Action ID="WaitForVLMVerdict">
      <input_port name="check_name"/>
    </Action>
  </TreeNodesModel>
</root>
