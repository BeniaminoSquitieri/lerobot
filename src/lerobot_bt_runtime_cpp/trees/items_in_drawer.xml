<!--
  @file items_in_drawer.xml
  @brief Human-robot collaborative task for placing objects into a drawer.

  The human opens and closes the drawer. The robot runs a repeatable BC skill
  that picks the next object and inserts it. After each insertion, if objects
  remain the VLM reports FAILURE and the skill is retried automatically.

  Every stage is a single merged leaf (AwaitScene or DoSkill) that combines
  the action with VLM verification.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="Items in drawer">
      <RetryUntilSuccessful name="Initial workspace ready" num_attempts="{initial_scene_ready_max_attempts}">
        <AwaitScene name="Check initial drawer workspace" scene_name="{initial_scene_ready_gate}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Human opens drawer" num_attempts="{drawer_open_gate_max_attempts}">
        <AwaitScene name="Check drawer is open" scene_name="{drawer_open_gate}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Insert items (retries until done)" num_attempts="{insert_next_drawer_item_max_attempts}">
        <DoSkill name="Robot inserts next drawer item" skill_name="{insert_next_drawer_item_skill}" timeout_s="{insert_next_drawer_item_timeout_s}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Human closes drawer" num_attempts="{drawer_closed_gate_max_attempts}">
        <AwaitScene name="Check drawer is closed" scene_name="{drawer_closed_gate}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Task complete" num_attempts="{task_complete_max_attempts}">
        <AwaitScene name="Check final drawer task state" scene_name="{task_complete_gate}"/>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="AwaitScene">
      <input_port name="scene_name"/>
    </Action>
    <Action ID="DoSkill">
      <input_port name="skill_name"/>
      <input_port name="timeout_s"/>
    </Action>
  </TreeNodesModel>
</root>
