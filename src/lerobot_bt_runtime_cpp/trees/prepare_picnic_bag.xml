<!--
  @file prepare_picnic_bag.xml
  @brief Scene-gated picnic bag preparation task.

  The VLM/manual verifier starts the BT only when the scene is ready, waits for
  the human to open and hold the bag, and decides after every robot rollout
  whether more objects still need to be inserted. Once the bag is full, the
  human closes it and the VLM confirms the scene is complete.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="Preparare la borsa del picnic - VLM scene gates">
      <RetryUntilSuccessful name="SCENE 0 - Picnic scene ready" num_attempts="{initial_scene_ready_max_attempts}">
        <Sequence name="Open setup gate, then wait for scene 0">
          <OpenVLMGate name="Open scene 0 gate" gate_name="{initial_scene_ready_gate}"/>
          <WaitForGateVerdict name="Wait scene 0 ready" gate_name="{initial_scene_ready_gate}"/>
        </Sequence>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="SCENE 1 - Human opens the bag" num_attempts="{human_open_bag_max_attempts}">
        <Sequence name="Open human-open-bag gate, then wait for bag ready">
          <OpenVLMGate name="Open human-open-bag gate" gate_name="{human_open_bag_gate}"/>
          <WaitForGateVerdict
            name="Wait scene 1 ready - bag open"
            gate_name="{human_open_bag_gate}"/>
        </Sequence>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="SCENE 2 - Insert next picnic item" num_attempts="{bag_next_picnic_item_max_attempts}">
        <Sequence name="Bag next item, then check if the scene is clean">
          <RunRobotSkill
            name="Bag next picnic item"
            skill_name="{bag_next_picnic_item_skill}"
            timeout_s="{bag_next_picnic_item_timeout_s}"/>
          <WaitForSkillVerdict
            name="Wait scene 2 verdict - all items bagged"
            skill_name="{bag_next_picnic_item_skill}"/>
        </Sequence>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="SCENE 3 - Human closes the bag" num_attempts="{human_close_bag_max_attempts}">
        <Sequence name="Open human-close-bag gate, then wait for bag closed">
          <OpenVLMGate name="Open human-close-bag gate" gate_name="{human_close_bag_gate}"/>
          <WaitForGateVerdict
            name="Wait scene 3 ready - bag closed"
            gate_name="{human_close_bag_gate}"/>
        </Sequence>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="TASK COMPLETE - Picnic bag ready" num_attempts="{task_complete_max_attempts}">
        <Sequence name="Open task-complete gate, then wait for final verdict">
          <OpenVLMGate name="Open task-complete gate" gate_name="{task_complete_gate}"/>
          <WaitForGateVerdict name="Wait task complete" gate_name="{task_complete_gate}"/>
        </Sequence>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="OpenVLMGate">
      <input_port name="gate_name"/>
    </Action>
    <Action ID="RunRobotSkill">
      <input_port name="skill_name"/>
      <input_port name="timeout_s"/>
    </Action>
    <Action ID="WaitForGateVerdict">
      <input_port name="gate_name"/>
    </Action>
    <Action ID="WaitForSkillVerdict">
      <input_port name="skill_name"/>
    </Action>
  </TreeNodesModel>
</root>
