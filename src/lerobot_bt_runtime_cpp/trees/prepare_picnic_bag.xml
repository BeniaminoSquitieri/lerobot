<!--
  @file prepare_picnic_bag.xml
  @brief Scene-gated picnic bag preparation task.

  Human and robot alternate inserting items into a picnic bag: human opens the
  bag and inserts Monster+mustard, robot inserts bread+pear. Every stage is a
  single merged leaf (AwaitScene or DoSkill).
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="Prepare picnic bag">
      <RetryUntilSuccessful name="Scene ready" num_attempts="{initial_scene_ready_max_attempts}">
        <AwaitScene name="Check picnic scene is ready" scene_name="{initial_scene_ready_gate}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Human opens bag" num_attempts="{human_open_bag_max_attempts}">
        <AwaitScene name="Check bag is open and held" scene_name="{human_open_bag_gate}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Human inserts Monster" num_attempts="{human_insert_monster_max_attempts}">
        <AwaitScene name="Check Monster drink is inside" scene_name="{human_insert_monster_gate}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Robot inserts bread" num_attempts="{bag_bread_max_attempts}">
        <DoSkill name="Bag bread" skill_name="{bag_bread_skill}" timeout_s="{bag_bread_timeout_s}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Human inserts mustard" num_attempts="{human_insert_mustard_max_attempts}">
        <AwaitScene name="Check mustard is inside" scene_name="{human_insert_mustard_gate}"/>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="Robot inserts pear" num_attempts="{bag_pear_max_attempts}">
        <DoSkill name="Bag pear" skill_name="{bag_pear_skill}" timeout_s="{bag_pear_timeout_s}"/>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="AwaitScene">
      <input_port name="scene_name"/>
    </Action>
    <Action ID="DoSkill">
      <input_port name="skill_name"/>
      <input_port name="timeout_s"/>
    </Action>
  </TreeNodesModel>
</root>
