<!--
  @file prepare_picnic_bag.xml
  @brief Scene-gated picnic bag preparation task.

  The VLM/manual verifier starts the BT only when the scene is ready, waits for
  the human to open and hold the bag, then gates explicit human and robot item
  insertion steps: human inserts the Monster drink, robot inserts the bread,
  human inserts the mustard, and robot inserts the pear.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="Preparare la borsa del picnic - VLM scene gates">
      <RetryUntilSuccessful name="SCENE 0 - Picnic scene ready" num_attempts="{initial_scene_ready_max_attempts}">
        <Sequence name="Open setup gate, then wait for scene 0">
          <OpenVLMGate name="Open scene 0 gate" gate_name="{initial_scene_ready_gate}"/>
          <WaitForVLMVerdict name="Wait scene 0 ready" check_name="{initial_scene_ready_gate}"/>
        </Sequence>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="SCENE 1 - Human opens the bag" num_attempts="{human_open_bag_max_attempts}">
        <Sequence name="Open human-open-bag gate, then wait for bag ready">
          <OpenVLMGate name="Open human-open-bag gate" gate_name="{human_open_bag_gate}"/>
          <WaitForVLMVerdict
            name="Wait scene 1 ready - bag open"
            check_name="{human_open_bag_gate}"/>
        </Sequence>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="SCENE 2 - Human inserts Monster drink" num_attempts="{human_insert_monster_max_attempts}">
        <Sequence name="Open human-insert-monster gate, then wait for scene 2">
          <OpenVLMGate name="Open human-insert-monster gate" gate_name="{human_insert_monster_gate}"/>
          <WaitForVLMVerdict
            name="Wait scene 2 ready - Monster drink bagged"
            check_name="{human_insert_monster_gate}"/>
        </Sequence>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="SCENE 3 - Robot inserts bread" num_attempts="{bag_bread_max_attempts}">
        <Sequence name="Bag bread, then check scene 3">
          <RunRobotSkill
            name="Bag bread"
            skill_name="{bag_bread_skill}"
            timeout_s="{bag_bread_timeout_s}"/>
          <WaitForVLMVerdict
            name="Wait scene 3 ready - bread bagged"
            check_name="{bag_bread_skill}"/>
        </Sequence>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="SCENE 4 - Human inserts mustard" num_attempts="{human_insert_mustard_max_attempts}">
        <Sequence name="Open human-insert-mustard gate, then wait for scene 4">
          <OpenVLMGate name="Open human-insert-mustard gate" gate_name="{human_insert_mustard_gate}"/>
          <WaitForVLMVerdict
            name="Wait scene 4 ready - mustard bagged"
            check_name="{human_insert_mustard_gate}"/>
        </Sequence>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="TASK COMPLETE - Robot inserts pear" num_attempts="{bag_pear_max_attempts}">
        <Sequence name="Bag pear, then check final scene">
          <RunRobotSkill
            name="Bag pear"
            skill_name="{bag_pear_skill}"
            timeout_s="{bag_pear_timeout_s}"/>
          <WaitForVLMVerdict
            name="Wait task complete - pear bagged"
            check_name="{bag_pear_skill}"/>
        </Sequence>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="OpenVLMGate">
      <input_port name="gate_name"/>
    </Action>
    <Action ID="RunRobotSkill">
      <input_port name="skill_name"/>
      <input_port name="timeout_s"/>
    </Action>
    <Action ID="WaitForVLMVerdict">
      <input_port name="check_name"/>
    </Action>
  </TreeNodesModel>
</root>
