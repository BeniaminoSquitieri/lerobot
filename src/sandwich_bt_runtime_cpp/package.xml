<?xml version="1.0"?>
<package format="3">
  <name>sandwich_bt_runtime_cpp</name>
  <version>0.0.0</version>
  <description>BehaviorTree.CPP runtime for the sandwich task.</description>
  <maintainer email="beniamino.squitieri@iit.it">Beniamino Squitieri</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>sandwich_bt_interfaces</depend>

  <!-- If your distro only ships behaviortree_cpp_v3, change this dependency to match. -->
  <depend>behaviortree_cpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
