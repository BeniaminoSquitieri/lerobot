<!--
  @file place_second_toast_subtree.xml
  @brief Standalone subtree for second-toast placement.

  This file executes only the robot stage that closes the sandwich. A VLM
  failure retries the same BC skill from the beginning.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <!-- MainTree contains one retrying skill+verification sequence. -->
  <BehaviorTree ID="MainTree">
    <!-- Retry forever until verification confirms the sandwich is closed. -->
    <RetryUntilSuccessful num_attempts="-1">
      <Sequence name="place_second_toast_retry_on_vlm_failure">
        <RunNamedCommand kind="skill" command_name="place_second_toast"/>
        <VerifySkillOutcome skill_name="place_second_toast"/>
      </Sequence>
    </RetryUntilSuccessful>
  </BehaviorTree>
</root>
