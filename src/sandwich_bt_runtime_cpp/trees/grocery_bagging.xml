<!--
  @file grocery_bagging.xml
  @brief Scene-gated grocery bagging task.

  The VLM/manual verifier checks that each item family has reached the expected
  bagging scene and that the bag remains usable.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="Grocery bagging - VLM scene gates">
      <RetryUntilSuccessful name="SCENE 0 - Bagging setup ready" num_attempts="{initial_scene_ready_max_attempts}">
        <Sequence name="Open setup gate, then wait for scene 0">
          <OpenVLMGate name="Open scene 0 gate" gate_name="{initial_scene_ready_gate}"/>
          <WaitForGateVerdict name="Wait scene 0 ready" gate_name="{initial_scene_ready_gate}"/>
        </Sequence>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="SCENE 1 - Rigid items bagged" num_attempts="{bag_rigid_or_cylindrical_item_max_attempts}">
        <Sequence name="Bag rigid item, then check scene 1">
          <RunRobotSkill
            name="Bag rigid or cylindrical item"
            skill_name="{bag_rigid_or_cylindrical_item_skill}"
            timeout_s="{bag_rigid_or_cylindrical_item_timeout_s}"/>
          <WaitForSkillVerdict
            name="Wait scene 1 ready - rigid items"
            skill_name="{bag_rigid_or_cylindrical_item_skill}"/>
        </Sequence>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="SCENE 2 - Flat or long items bagged" num_attempts="{bag_flat_or_long_item_max_attempts}">
        <Sequence name="Bag flat item, then check scene 2">
          <RunRobotSkill
            name="Bag flat or long item"
            skill_name="{bag_flat_or_long_item_skill}"
            timeout_s="{bag_flat_or_long_item_timeout_s}"/>
          <WaitForSkillVerdict
            name="Wait scene 2 ready - flat items"
            skill_name="{bag_flat_or_long_item_skill}"/>
        </Sequence>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="SCENE 3 - Soft or fragile items bagged" num_attempts="{bag_soft_or_fragile_item_max_attempts}">
        <Sequence name="Bag soft item, then check scene 3">
          <RunRobotSkill
            name="Bag soft or fragile item"
            skill_name="{bag_soft_or_fragile_item_skill}"
            timeout_s="{bag_soft_or_fragile_item_timeout_s}"/>
          <WaitForSkillVerdict
            name="Wait scene 3 ready - soft items"
            skill_name="{bag_soft_or_fragile_item_skill}"/>
        </Sequence>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="TASK COMPLETE - Groceries bagged" num_attempts="{task_complete_max_attempts}">
        <Sequence name="Open task-complete gate, then wait for final verdict">
          <OpenVLMGate name="Open task-complete gate" gate_name="{task_complete_gate}"/>
          <WaitForGateVerdict name="Wait task complete" gate_name="{task_complete_gate}"/>
        </Sequence>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="OpenVLMGate">
      <input_port name="gate_name"/>
    </Action>
    <Action ID="RunRobotSkill">
      <input_port name="skill_name"/>
      <input_port name="timeout_s"/>
    </Action>
    <Action ID="WaitForGateVerdict">
      <input_port name="gate_name"/>
    </Action>
    <Action ID="WaitForSkillVerdict">
      <input_port name="skill_name"/>
    </Action>
  </TreeNodesModel>
</root>
