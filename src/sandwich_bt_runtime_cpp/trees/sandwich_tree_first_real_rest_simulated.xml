<!--
  @file sandwich_tree_first_real_rest_simulated.xml
  @brief Hybrid tree: first toast is real, later stages use no-motion commands.

  The first primitive uses kind="skill" so it reaches the real executor path.
  The following primitives use no-motion/VLM gates so developers can test the
  full BT control flow without executing all robot motions. Named retry and
  VLM decision nodes are used so Groot exposes the replanning points.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <!-- MainTree is the entry point loaded by sandwich_bt_runner. -->
  <BehaviorTree ID="MainTree">
    <!-- Execute the real first stage, then simulated pour and closure stages. -->
    <Sequence name="sandwich_first_real_rest_simulated">
      <!-- Real stage: execute first-toast policy, verify. -->
      <RetryUntilSuccessful name="retry_place_first_toast_on_vlm_retry_skill" num_attempts="-1">
        <Sequence name="place_first_toast_real_skill_vlm_replanning_loop">
          <RunNamedCommand kind="skill" command_name="place_first_toast" timeout_s="120.0"/>
          <VLMReplanningDecision
            name="continue_wait_manual_or_retry_place_first_toast"
            skill_name="place_first_toast"/>
        </Sequence>
      </RetryUntilSuccessful>

      <!-- Human pouring gate: wait for VLM/manual verifier, no robot motion. -->
      <RetryUntilSuccessful name="retry_human_pouring_until_vlm_success" num_attempts="-1">
        <Sequence name="human_pouring_wait_or_manual_intervention_gate">
          <RunNamedCommand kind="vlm_gate_pending" command_name="pour_ingredient"/>
          <WaitForVLMDecision
            name="wait_human_pouring_running_success_or_manual_intervention"
            skill_name="pour_ingredient"/>
        </Sequence>
      </RetryUntilSuccessful>

      <!-- No-motion stage: exercise top-toast BT control flow without robot motion. -->
      <RetryUntilSuccessful name="retry_place_second_toast_on_vlm_retry_skill" num_attempts="-1">
        <Sequence name="place_second_toast_no_motion_skill_vlm_replanning_loop">
          <RunNamedCommand kind="no_motion_skill" command_name="place_second_toast"/>
          <VLMReplanningDecision
            name="continue_wait_manual_or_retry_place_second_toast"
            skill_name="place_second_toast"/>
        </Sequence>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="RunNamedCommand">
      <input_port name="kind"/>
      <input_port name="command_name"/>
      <input_port name="timeout_s"/>
    </Action>
    <Action ID="WaitForVLMDecision">
      <input_port name="skill_name"/>
    </Action>
    <Action ID="VLMReplanningDecision">
      <input_port name="skill_name"/>
    </Action>
  </TreeNodesModel>
</root>
