<!--
  @file sandwich_tree_two_real_skills_manual_vlm.xml
  @brief Temporary bring-up tree with two real BC skills and manual/VLM topic gates.

  This tree matches the current real-robot test task:
  1. wait for the scene-ready verdict,
  2. run the first real toast skill,
  3. wait for human pouring to be verified,
  4. run the second real toast skill.

  The verifier can be a real VLM or a human publishing the same JSON verdicts
  on /sandwich_bt/vlm_result. The BT does not depend on who publishes.
  Named retry and VLM decision nodes are used so Groot exposes the replanning
  structure during bring-up.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="two_real_skills_manual_vlm_task">
      <!-- Stage 0: no robot motion; wait until the initial scene is ready. -->
      <RetryUntilSuccessful name="retry_initial_scene_until_vlm_success" num_attempts="-1">
        <Sequence name="initial_scene_vlm_replanning_gate">
          <RunNamedCommand kind="simulated_skill_pending" command_name="initial_scene_ready"/>
          <WaitForVLMDecision name="wait_initial_scene_ready_or_manual_intervention" skill_name="initial_scene_ready"/>
        </Sequence>
      </RetryUntilSuccessful>

      <!-- Stage 1: first real BC primitive, then VLM/manual verification. -->
      <RetryUntilSuccessful name="retry_place_first_toast_on_vlm_retry_skill" num_attempts="-1">
        <Sequence name="place_first_toast_real_skill_vlm_replanning_loop">
          <RunNamedCommand kind="skill" command_name="place_first_toast" timeout_s="30.0"/>
          <VLMReplanningDecision
            name="continue_wait_manual_or_retry_place_first_toast"
            skill_name="place_first_toast"/>
        </Sequence>
      </RetryUntilSuccessful>

      <!-- Stage 2: human pouring; the gate succeeds only after topic verification. -->
      <RetryUntilSuccessful name="retry_human_pouring_until_vlm_success" num_attempts="-1">
        <Sequence name="human_pouring_wait_or_manual_intervention_gate">
          <RunNamedCommand kind="simulated_skill_pending" command_name="pour_ingredient"/>
          <WaitForVLMDecision
            name="wait_human_pouring_running_success_or_manual_intervention"
            skill_name="pour_ingredient"/>
        </Sequence>
      </RetryUntilSuccessful>

      <!-- Stage 3: second real BC primitive, then final VLM/manual verification. -->
      <RetryUntilSuccessful name="retry_place_second_toast_on_vlm_retry_skill" num_attempts="-1">
        <Sequence name="place_second_toast_real_skill_vlm_replanning_loop">
          <RunNamedCommand kind="skill" command_name="place_second_toast" timeout_s="30.0"/>
          <VLMReplanningDecision
            name="continue_wait_manual_or_retry_place_second_toast"
            skill_name="place_second_toast"/>
        </Sequence>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="RunNamedCommand">
      <input_port name="kind"/>
      <input_port name="command_name"/>
      <input_port name="timeout_s"/>
    </Action>
    <Action ID="WaitForVLMDecision">
      <input_port name="skill_name"/>
    </Action>
    <Action ID="VLMReplanningDecision">
      <input_port name="skill_name"/>
    </Action>
  </TreeNodesModel>
</root>
