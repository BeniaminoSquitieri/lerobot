<!--
  @file lunch_table_bussing.xml
  @brief Scene-gated lunch table bussing task.

  The BT owns the fixed task order. Each BC skill is retried until the VLM/manual
  verifier reports that the expected next scene has been reached.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="Lunch table bussing - VLM scene gates">
      <RetryUntilSuccessful name="SCENE 0 - Table setup ready" num_attempts="-1">
        <Sequence name="Open setup gate, then wait for scene 0">
          <OpenVLMGate name="Open scene 0 gate" gate_name="{initial_scene_ready_gate}"/>
          <WaitForGateVerdict name="Wait scene 0 ready" gate_name="{initial_scene_ready_gate}"/>
        </Sequence>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="SCENE 1 - Loose trash removed" num_attempts="3">
        <Sequence name="Dispose trash, then check scene 1">
          <RunRobotSkill
            name="Pick and dispose trash"
            skill_name="{pick_and_dispose_trash_skill}"
            timeout_s="{pick_and_dispose_trash_timeout_s}"/>
          <WaitForSkillVerdict
            name="Wait scene 1 ready - trash"
            skill_name="{pick_and_dispose_trash_skill}"/>
        </Sequence>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="SCENE 2 - Plates managed" num_attempts="3">
        <Sequence name="Clear plate, then check scene 2">
          <RunRobotSkill
            name="Clear plate"
            skill_name="{clear_plate_skill}"
            timeout_s="{clear_plate_timeout_s}"/>
          <WaitForSkillVerdict
            name="Wait scene 2 ready - plates"
            skill_name="{clear_plate_skill}"/>
        </Sequence>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="SCENE 3 - Cutlery stored" num_attempts="4">
        <Sequence name="Store cutlery, then check scene 3">
          <RunRobotSkill
            name="Pick and store cutlery"
            skill_name="{pick_and_store_cutlery_skill}"
            timeout_s="{pick_and_store_cutlery_timeout_s}"/>
          <WaitForSkillVerdict
            name="Wait scene 3 ready - cutlery"
            skill_name="{pick_and_store_cutlery_skill}"/>
        </Sequence>
      </RetryUntilSuccessful>

      <RetryUntilSuccessful name="SCENE 4 - Dishware stored" num_attempts="3">
        <Sequence name="Store dishware, then check scene 4">
          <RunRobotSkill
            name="Pick and store dishware"
            skill_name="{pick_and_store_dishware_skill}"
            timeout_s="{pick_and_store_dishware_timeout_s}"/>
          <WaitForSkillVerdict
            name="Wait scene 4 ready - dishware"
            skill_name="{pick_and_store_dishware_skill}"/>
        </Sequence>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="OpenVLMGate">
      <input_port name="gate_name"/>
    </Action>
    <Action ID="RunRobotSkill">
      <input_port name="skill_name"/>
      <input_port name="timeout_s"/>
    </Action>
    <Action ID="WaitForGateVerdict">
      <input_port name="gate_name"/>
    </Action>
    <Action ID="WaitForSkillVerdict">
      <input_port name="skill_name"/>
    </Action>
  </TreeNodesModel>
</root>
