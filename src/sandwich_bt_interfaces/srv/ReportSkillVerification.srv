# Report the verification verdict for a named skill attempt.
#
# This is the external verifier/VLM -> Python verification relay boundary.
string skill_name
# 0 means "apply to the latest pending attempt for this skill".
int32 attempt_id
# Expected values: SUCCESS or FAILURE.
string status
# Optional explanation from the verifier.
string message
# Optional confidence score from the verifier.
float32 confidence
---
# Whether the report was accepted and applied.
bool accepted
# Attempt that was updated when the report succeeded.
int32 applied_attempt_id
# Diagnostic message for logs or tooling.
string message
