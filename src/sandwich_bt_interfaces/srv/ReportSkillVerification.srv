# @file ReportSkillVerification.srv
# @brief Legacy external verifier to Python VLM-check-registry update boundary.
#
# Request fields:
# skill_name identifies the primitive whose attempt is being judged.
string skill_name
# attempt_id selects a concrete attempt; 0 applies to the latest pending attempt.
int32 attempt_id
# status is the verifier update:
#   PENDING/RUNNING/WAIT_HUMAN/MANUAL_INTERVENTION_REQUIRED keep the BT blocked
#   SUCCESS advances the BT
#   FAILURE triggers XML retry/failure logic
string status
# message explains the verdict for logs, operators, and tests.
string message
# confidence is the optional confidence score reported by the verifier.
float32 confidence
---
# Response fields:
# accepted is true when the registry applied the report.
bool accepted
# applied_attempt_id is the attempt updated when accepted is true.
int32 applied_attempt_id
# message describes rejection or success details for tooling.
string message
