# @file PlanNextStep.srv
# @brief Collaborative runner to supervisor next-step planning boundary.
#
# Request fields:
# goal is the high-level sandwich objective being pursued.
string goal
# current_task is the last known primitive/task name or an empty string at start.
string current_task
# available_robot_skills lists robot-capable closed-set primitive names.
string[] available_robot_skills
# available_human_skills lists human-capable closed-set primitive names.
string[] available_human_skills
# first_toast_on_plate mirrors the scene estimator boolean for the base toast.
bool first_toast_on_plate
# ingredient_on_first_toast mirrors whether filling has been placed.
bool ingredient_on_first_toast
# second_toast_on_top mirrors whether the sandwich has been closed.
bool second_toast_on_top
---
# Response fields:
# step_name names the selected primitive or DONE when the task is complete.
string step_name
# actor is ROBOT, HUMAN, DONE, or another configured closed-set actor label.
string actor
# reason explains why the supervisor selected this step.
string reason
# expected_state describes the scene state expected after execution.
string expected_state
# confidence records planner certainty for logging and arbitration.
float32 confidence
