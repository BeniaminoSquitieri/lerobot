# Request one named command from the Python skill/recovery executor.
#
# This is the C++ BT -> Python execution boundary.
# Request sent by the C++ BT to the Python server.
# kind:
#   - "skill"    -> run one learned primitive
#   - "recovery" -> run one scripted recovery
# name:
#   must match one configured entry on the Python side
# timeout_s:
#   optional override for the command duration
string kind
string name
float32 timeout_s
---
# Response returned by the Python server to the BT.
# success/status are what the BT uses to decide whether to continue or retry.
bool success
string status
float32 elapsed_s
string message
