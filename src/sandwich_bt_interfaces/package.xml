<?xml version="1.0"?>
<!--
  @file package.xml
  @brief ROS2 package manifest for generated sandwich BT service interfaces.
-->
<package format="3">
  <!-- Package identity shown by colcon and the ament index. -->
  <name>sandwich_bt_interfaces</name>
  <version>0.0.0</version>
  <description>ROS2 service interfaces for the sandwich behavior tree stack.</description>
  <maintainer email="beniamino.squitieri@iit.it">Beniamino Squitieri</maintainer>
  <license>Apache-2.0</license>

  <!-- Build system and ROS interface-generation entry points. -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_cmake</buildtool_depend>

  <!-- Generators and type support needed for C, C++, and Python service users. -->
  <build_depend>rosidl_generator_c</build_depend>
  <build_depend>rosidl_generator_cpp</build_depend>
  <build_depend>rosidl_generator_py</build_depend>
  <build_depend>rosidl_typesupport_c</build_depend>
  <build_depend>rosidl_typesupport_cpp</build_depend>
  <build_depend>rosidl_typesupport_introspection_c</build_depend>
  <build_depend>rosidl_typesupport_introspection_cpp</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Required marker for packages that define .srv/.msg/.action files. -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- Tell ament this package is built with CMake. -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
