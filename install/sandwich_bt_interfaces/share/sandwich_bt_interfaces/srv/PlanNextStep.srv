# Plan the next closed-set sandwich step.
#
# This is the runner -> supervisor planning boundary.
# Request sent by the collaborative supervisor client.
string goal
string current_task
string[] available_robot_skills
string[] available_human_skills
bool first_toast_on_plate
bool ingredient_on_first_toast
bool second_toast_on_top
---
# Response returned by the collaborative supervisor.
string step_name
string actor
string reason
string expected_state
float32 confidence
