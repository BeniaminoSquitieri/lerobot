# @file GetSkillVerification.srv
# @brief BT runtime to Python VLM-check-registry query boundary.
#
# Request fields:
# skill_name identifies the primitive whose latest attempt should be inspected.
string skill_name
---
# Response fields:
# has_attempt tells the BT whether the Python side has recorded this skill.
bool has_attempt
# attempt_id is the monotonic identifier assigned by the Python server.
int32 attempt_id
# status is one of UNKNOWN, PENDING, RUNNING, WAIT_HUMAN,
# MANUAL_INTERVENTION_REQUIRED, SUCCESS, or FAILURE.
string status
# message provides human-readable status detail.
string message
